# Persönliche/sensible Falldaten - dürfen nie versioniert werden
data/
dokumente/

# Von Nutzerinnen selbst hinzugefügte Word-Vorlagen (siehe Datei-Menü →
# Einstellungen → Vorlagen) - können persönliche Angaben wie Briefkopf
# oder Unterschrift enthalten und sind daher wie Falldaten zu behandeln
vorlagen/

# Python
__pycache__/
*.pyc
venv/

# PyInstaller-Build-Ausgabe (siehe GuMa.spec) - wird von
# .github/workflows/build-windows.yml erzeugt, nicht versioniert
build/
dist/

# Vom Windows-Start-Skript erzeugt / Editor-/OS-Dateien
*.log
.DS_Store
